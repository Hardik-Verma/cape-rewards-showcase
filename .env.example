# ===== CAPEVERSE Rewards - Environment Template =====
# Copy to Render (Environment Variables). No real secrets in this file.

# Server
PORT=3000

# MongoDB (Atlas connection string)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/capeverse

# Discord Bot
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here
REWARD_ROLE_ID=your_reward_role_id_here

# Site URLs
BASE_URL=https://yourdomain.com
DISCORD_INVITE_LINK=https://discord.gg/your-invite

# Bitcotasks (API Key goes INTO the URL path, Secret Key stays raw)
BITCOTASKS_URL=https://bitcotasks.com/offerwall/YOUR_API_KEY/
BITCOTASKS_SECRET=your_bitcotasks_secret_key_here

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# JWT signing key (random long string)
JWT_SECRET=change-me-to-a-long-random-string

# Optional: Brevo for email verification codes
BREVO_API_KEY=your_brevo_api_key_here
SENDER_EMAIL=no-reply@yourdomain.com

# Optional: ImgBB for admin item image uploads
IMGBB_API_KEY=your_imgbb_api_key_here